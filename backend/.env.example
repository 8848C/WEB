# 复制为 .env 后按需修改；.env 不要提交到版本库
# cp .env.example .env

APP_NAME=Kun Login
APP_ENV=development
DEBUG=true

# ---- 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=kun
DB_PASSWORD=改成你自己的密码
DB_NAME=kun_login
DB_ECHO=false

# ---- 鉴权 ----
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=请替换为随机串
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ---- 跨域（逗号分隔）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 登录限流 ----
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=300
